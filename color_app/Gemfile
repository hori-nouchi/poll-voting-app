source "https://rubygems.org"

# Railsのバージョン指定
gem "rails", "~> 8.0.1"

# アセットパイプライン
gem "propshaft"

# Webサーバー
gem "puma", ">= 5.0"

# JavaScript / CSS 関連
gem "importmap-rails"
gem "turbo-rails"
gem "stimulus-rails"

# JSON API作成用
gem "jbuilder"

# ユーザー認証
gem "devise", "~> 4.9"

# Windows用のタイムゾーンデータ
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Rails 8の標準機能（キャッシュ・キュー・ケーブル）
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"

# 起動時間の高速化
gem "bootsnap", require: false

# デプロイツール
gem "kamal", require: false
gem "thruster", require: false

# 画像処理
gem "image_processing", "~> 1.2"

# 開発環境とテスト環境で共通のGem
group :development, :test do
  # 開発PCでのデータベースはSQLiteを使用
  gem "sqlite3", ">= 2.1"
  
  # デバッグツール
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
  
  # セキュリティ・スタイルチェック
  gem "bundler-audit", require: false
  gem "brakeman", require: false
  gem "rubocop-rails-omakase", require: false
end

# 開発環境のみ
group :development do
  # ブラウザ上でのコンソール表示
  gem "web-console"
end

# テスト環境のみ
group :test do
  # システムテスト用
  gem "capybara"
  gem "selenium-webdriver"
end

# 本番環境（Renderなど）のみ
group :production do
  # 本番のデータベースはPostgreSQLを使用
  gem "pg"
end