<style>
  body { background-color: #fdfbfb; font-family: sans-serif; }
  .reg-container { max-width: 400px; margin: 60px auto; background: white; padding: 40px 30px; border-radius: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border-top: 10px solid #88a4d4; }
  .field { margin-bottom: 20px; }
  .label-text { display: block; font-weight: bold; color: #777; margin-bottom: 8px; font-size: 0.9rem; }
  .input-field { width: 100%; padding: 12px; border: 2px solid #eee; border-radius: 12px; box-sizing: border-box; }
  .submit-btn { width: 100%; background-color: #88a4d4; color: white; border: none; padding: 15px; border-radius: 50px; font-weight: bold; cursor: pointer; }
</style>

<div class="reg-container">
  <h2 style="text-align: center; color: #88a4d4;">新しく始める 🎨</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <span class="label-text">ニックネーム</span>
      <%= f.text_field :name, autofocus: true, class: "input-field", placeholder: "好きな名前を教えてね" %>
    </div>

    <div class="field">
      <span class="label-text">メールアドレス</span>
      <%= f.email_field :email, autocomplete: "email", class: "input-field" %>
    </div>

    <div class="field">
      <span class="label-text">パスワード（6文字以上）</span>
      <%= f.password_field :password, autocomplete: "new-password", class: "input-field" %>
    </div>

    <div class="field">
      <span class="label-text">パスワード（確認）</span>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field" %>
    </div>

    <div class="actions">
      <%= f.submit "登録する", class: "submit-btn" %>
    </div>
  <% end %>

  <div style="margin-top: 20px; text-align: center;">
    <%= render "devise/shared/links" %>
  </div>
</div>