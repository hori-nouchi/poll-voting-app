<file path="app/views/polls/_choice_fields.html.erb">
<%# app/views/polls/_choice_fields.html.erb %>
<%# wrapper ターゲットとして定義し、JavaScriptからこの要素ごと操作できるようにします %>
<div class="nested-fields" data-nested-form-target="wrapper">
  <div class="input-group">
    <%# 選択肢の入力フィールド %>
    <%= form.text_field :content, 
                        class: "form-control", 
                        placeholder: "選択肢を入力してください", 
                        required: true %>

    <%# 削除ボタン: JavaScriptの nested-form#remove アクションを起動 %>
    <button type="button" 
            class="btn btn-outline-danger" 
            data-action="click->nested-form#remove"
            title="削除">
      <i class="bi bi-trash"></i>
    </button>
  </div>

  <%# 🚨 重要: 削除フラグを保持する隠しフィールド 🚨 %>
  <%# allow_destroy: true を設定している場合、このフィールドが '1' になるとレコードが削除されます %>
  <%= form.hidden_field :_destroy %>
</div>
</file>

<file path="app/views/polls/_form.html.erb">
<%= form_with(model: poll, local: true, data: { controller: "poll-form" }) do |f| %>
  <div class="mb-3">
    <%= f.label :title, "アンケートタイトル", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "例：好きな果物は？" %>
  </div>

  <div class="mb-3">
    <label class="form-label">選択肢</label>
    
    <%# 1. コンテナにターゲットを設定 %>
    <div id="choices-container" data-poll-form-target="container">
      <%= f.fields_for :choices do |choice_form| %>
        <div class="choice-field d-flex mb-2 gap-2">
          <%= choice_form.text_field :content, class: "form-control", placeholder: "選択肢を入力" %>
          
          <%# 2. 削除ボタンにアクションを設定 %>
          <button type="button" class="btn btn-outline-danger" data-action="click->poll-form#removeChoice">
             削除
          </button>
        </div>
      <% end %>
    </div>

    <%# 3. 追加ボタンにアクションを設定 %>
    <button type="button" class="btn btn-outline-primary btn-sm mt-2" data-action="click->poll-form#addChoice">
      + 選択肢を追加
    </button>
  </div>

  <%# 4. テンプレートを隠し要素として定義 %>
  <template data-poll-form-target="template">
    <%= f.fields_for :choices, Choice.new, child_index: "NEW_RECORD" do |choice_form| %>
      <div class="choice-field d-flex mb-2 gap-2">
        <%= choice_form.text_field :content, class: "form-control", placeholder: "選択肢を入力" %>
        <button type="button" class="btn btn-outline-danger" data-action="click->poll-form#removeChoice">
           削除
        </button>
      </div>
    <% end %>
  </template>

  <div class="mt-4">
    <%= f.submit "アンケートを作成する", class: "btn btn-primary w-100" %>
  </div>
<% end %>
</file>

