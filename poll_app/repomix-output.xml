<file path="app/models/choice.rb">
class Choice < ApplicationRecord
  # --- Associations ---
  
  # Links each choice to a specific poll
  belongs_to :poll, inverse_of: :choices
  
  # Votes linked to this specific choice
  has_many :votes, dependent: :destroy 

  # --- Validations ---
  
  # 削除フラグが立っていない場合のみ、バリデーションを実行する
  validates :content, 
            presence: true, 
            length: { maximum: 100 },
            unless: :reject_by_destroy_flag?

  # --- Methods ---

  # フォームから送信される _destroy フラグを安全に判定するメソッド
  # メソッド名を独自のものにすることで、Rails内部の無限ループを回避します
  def reject_by_destroy_flag?
    # 1. accepts_nested_attributes_for の内部状態を確認
    return true if marked_for_destruction?
    
    # 2. フォームから直接送られてくる _destroy パラメータを確認
    # attr_accessor :_destroy がない場合でも、パラメータが存在すれば true を返す
    [true, "1", 1].include?(instance_variable_get(:@_destroy)) || 
    (respond_to?(:_destroy) && [true, "1", 1].include?(_destroy))
  end
end
</file>

<file path="app/models/poll.rb">
class Poll < ApplicationRecord
  # 1. 関連付け
  belongs_to :user
  has_many :choices, dependent: :destroy, inverse_of: :poll
  has_many :votes, through: :choices

  # 2. ネストした属性の設定
  accepts_nested_attributes_for :choices, 
                                allow_destroy: true, 
                                reject_if: :all_blank

  # 3. バリデーション
  validates :title, presence: true, length: { maximum: 100 }
  validates :description, presence: true
  validates :status, presence: true

  # カスタムバリデーション
  validate :must_have_at_least_two_choices

  private

  def must_have_at_least_two_choices
    # 関連付けられた choices のうち、削除フラグが立っていないものを数える
    # メモリ上のオブジェクトを直接参照し、メソッド呼び出しを最小限にします
    valid_choices_count = choices.to_a.count do |choice|
      # _destroy 属性が真（"1" や true）でないものを有効な選択肢としてカウント
      # choice.marked_for_destruction? がエラーになるため、属性値を直接参照
      is_marked_for_destruction = choice.respond_to?(:_destroy) && [true, "1", 1].include?(choice._destroy)
      
      !choice.marked_for_destruction? && !is_marked_for_destruction rescue !is_marked_for_destruction
    end

    if valid_choices_count < 2
      errors.add(:base, "選択肢は2つ以上入力してください。")
    end
  end
end
</file>

