<file path="app/views/polls/new.html.erb">
<div class="poll-app-wrapper">
  <div class="poll-container">
    <header class="poll-header">
      <h1 class="poll-heading">新規アンケート作成</h1>
      <p class="poll-subheading">質問内容と選択肢を自由に設定してください。</p>
    </header>

    <div class="poll-card">
      <%= form_with(model: @poll, local: true, id: "poll-form") do |f| %>
        
        <% if @poll.errors.any? %>
          <div class="error-notification">
            <h2 class="error-title"><%= @poll.errors.count %> 件のエラーがあります</h2>
            <ul class="error-list">
              <% @poll.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-group">
          <%= f.label :title, "アンケートのタイトル", class: "form-label" %>
          <%= f.text_field :title, placeholder: "例: 好きなプログラミング言語は？", class: "form-control", required: true %>
        </div>

        <div class="form-group">
          <%= f.label :description, "詳細説明 (任意)", class: "form-label" %>
          <%= f.text_area :description, rows: 2, placeholder: "アンケートの補足情報を入力...", class: "form-control" %>
        </div>

        <!-- 選択肢セクション -->
        <div class="options-section">
          <div class="options-header">
            <h3 class="options-title">選択肢</h3>
            <button type="button" id="add-choice" class="btn-add">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              追加
            </button>
          </div>

          <div id="choices-container">
            <!-- JavaScriptで動的に追加される、または初期の選択肢 -->
            <div class="choice-row" data-index="0">
              <div class="choice-input-wrapper">
                <input type="text" name="poll[choices_attributes][0][content]" placeholder="選択肢を入力" class="form-control choice-field" required>
                <button type="button" class="remove-choice" title="削除">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
            <div class="choice-row" data-index="1">
              <div class="choice-input-wrapper">
                <input type="text" name="poll[choices_attributes][1][content]" placeholder="選択肢を入力" class="form-control choice-field" required>
                <button type="button" class="remove-choice" title="削除">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="form-footer">
          <%= f.submit "アンケートを公開する", class: "btn btn-submit" %>
          <%= link_to "キャンセル", polls_path, class: "btn btn-cancel" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
  :root {
    --primary: #4f46e5;
    --primary-hover: #4338ca;
    --bg-gray: #f9fafb;
    --text-dark: #111827;
    --text-light: #6b7280;
    --border: #d1d5db;
    --white: #ffffff;
    --danger: #ef4444;
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .poll-app-wrapper {
    background-color: var(--bg-gray);
    min-height: 100vh;
    padding: 40px 20px;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .poll-container {
    max-width: 550px;
    margin: 0 auto;
  }

  .poll-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .poll-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-dark);
  }

  .poll-card {
    background: var(--white);
    border-radius: 12px;
    box-shadow: var(--shadow);
    padding: 24px;
  }

  .form-group { margin-bottom: 20px; }
  .form-label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.9rem; }
  
  .form-control {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 1rem;
    box-sizing: border-box;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
  }

  /* Dynamic Section */
  .options-section {
    margin-top: 24px;
    border-top: 1px solid #edf2f7;
    padding-top: 20px;
  }

  .options-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .options-title { font-size: 1.1rem; font-weight: 700; margin: 0; }

  .btn-add {
    background: #ecf0ff;
    color: var(--primary);
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .btn-add:hover { background: #e0e7ff; }

  .choice-row {
    margin-bottom: 12px;
    animation: fadeIn 0.2s ease-out;
  }

  .choice-input-wrapper {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .remove-choice {
    background: none;
    border: none;
    color: var(--text-light);
    cursor: pointer;
    padding: 8px;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .remove-choice:hover {
    color: var(--danger);
    background: #fef2f2;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .form-footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 32px;
  }

  .btn {
    padding: 12px;
    border-radius: 6px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    border: none;
  }

  .btn-submit { background: var(--primary); color: white; }
  .btn-cancel { background: #f3f4f6; color: var(--text-light); }

  @media (min-width: 480px) {
    .form-footer { flex-direction: row-reverse; }
    .btn { flex: 1; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('choices-container');
    const addButton = document.getElementById('add-choice');

    // 選択肢の追加
    addButton.addEventListener('click', () => {
      const rows = container.querySelectorAll('.choice-row');
      const nextIndex = rows.length > 0 ? parseInt(rows[rows.length - 1].dataset.index) + 1 : 0;
      
      const newRow = document.createElement('div');
      newRow.className = 'choice-row';
      newRow.dataset.index = nextIndex;
      newRow.innerHTML = `
        <div class="choice-input-wrapper">
          <input type="text" name="poll[choices_attributes][${nextIndex}][content]" placeholder="選択肢を入力" class="form-control choice-field" required>
          <button type="button" class="remove-choice" title="削除">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      `;
      container.appendChild(newRow);
    });

    // 選択肢の削除（イベントデリゲーション）
    container.addEventListener('click', (e) => {
      if (e.target.closest('.remove-choice')) {
        const row = e.target.closest('.choice-row');
        const rows = container.querySelectorAll('.choice-row');
        
        // 最低2つの選択肢を残すバリデーション（任意）
        if (rows.length > 1) {
          row.remove();
        } else {
          alert('選択肢は最低1つ必要です。');
        }
      }
    });
  });
</script>
</file>

<file path="app/views/polls/result.html.erb">
<!-- app/views/polls/result.html.erb -->
<div class="container my-5">
    
    <h2>投票結果</h2>
    <p class="text-secondary">アンケートタイトル:</p>
    <h3><%= @poll.title %></h3>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card text-center bg-info text-white shadow-sm p-3 rounded-3">
                <div class="card-body">
                    <h5 class="card-title">総投票数</h5>
                    <p class="card-text fs-1 fw-bold"><%= @total_votes %> 票</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card shadow-sm p-3 h-100 rounded-3">
                <h5 class="card-title">グラフ表示エリア</h5>
                <div style="height: 200px; background-color: #f8f9fa; border: 1px dashed #ccc; display: flex; align-items: center; justify-content: center; font-style: italic; border-radius: 0.5rem;">
                    投票結果のグラフ（棒グラフまたは円グラフ）<br>（注: グラフライブラリがないため、プレースホルダーです）
                </div>
            </div>
        </div>
    </div>

    <h4 class="mt-5 mb-3">結果内訳</h4>

    <div class="list-group">
        <% if @total_votes > 0 %>
            <% # @results は、キーが選択肢のテキスト、値が投票数のハッシュ (例: {"はい" => 10, "いいえ" => 5}) %>
            <% @results.each_with_index do |(option_text, count), index| %>
                <% 
                    # 割合を計算 (小数点以下1桁まで)
                    percentage = (@total_votes > 0) ? (count.to_f / @total_votes * 100).round(1) : 0
                    # プログレスバーの色を設定 (Bootstrapのユーティリティクラス)
                    # indexを使って色のバリエーションを確保します
                    color_class = case index % 4
                                  when 0 then "bg-primary"
                                  when 1 then "bg-success"
                                  when 2 then "bg-warning"
                                  when 3 then "bg-danger"
                                  end
                %>
                <div class="list-group-item p-3 rounded-3 mb-2 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-truncate text-wrap me-3" style="max-width: 70%;"><%= option_text %></strong>
                        <span>
                            <span class="badge bg-secondary me-2"><%= percentage %>%</span>
                            <span class="badge bg-dark"><%= count %> 票</span>
                        </span>
                    </div>
                    <div class="progress" role="progressbar" style="height: 10px;">
                        <div class="progress-bar <%= color_class %>" style="width: <%= percentage %>%"></div>
                    </div>
                </div>
            <% end %>
        <% else %>
            <div class="alert alert-info p-3 text-center" role="alert">
                まだ投票がありません。最初の投票者になりましょう！
            </div>
        <% end %>
    </div>

    <div class="mt-5 text-center">
        <%= link_to 'アンケート一覧へ戻る', polls_path, class: 'btn btn-outline-secondary' %>
        <%# 🚨 修正: Vote.exists? のチェック方法を current_user と poll を使用するように変更 🚨 %>
        <% if !logged_in? || !Vote.exists?(user: current_user, poll: @poll) %>
            <%= link_to '投票ページに戻る', poll_path(@poll), class: "btn btn-outline-primary ms-3" %>
        <% end %>
    </div>

</div>
</file>

<file path="app/views/polls/show.html.erb">
<h2><%= @poll.title %></h2>
<p class="text-secondary">
  作成者: <%= @poll.user.email %> | 
  作成日時: <%= l @poll.created_at, format: :short %>
</p>

<div class="card p-4 shadow-sm">
  <h4 class="card-title mb-3">投票フォーム</h4>

  <%# Turboの非同期処理によるリダイレクトの不具合を防ぐため data: { turbo: false } を維持 %>
  <%= form_with(url: vote_poll_path(@poll), method: :post, data: { turbo: false }) do |f| %>
    
    <p class="mb-3">いずれか一つの選択肢を選んで投票してください。</p>
    
    <div class="poll-choices">
      <% @poll.choices.each do |choice| %>
        <div class="form-check mb-2">
          <% # ラジオボタン。name属性を :choice_id とすることで、コントローラーで params[:choice_id] として取得可能 %>
          <%= radio_button_tag :choice_id, choice.id, false, 
              id: "choice_#{choice.id}", 
              class: "form-check-input", 
              required: true %>
          
          <% # ラベルをクリックしてもラジオボタンが選択されるように id を紐付け %>
          <%= label_tag "choice_#{choice.id}", choice.content, class: "form-check-label" %>
        </div>
      <% end %>
    </div>

    <hr>
    <div class="actions">
      <%= submit_tag "投票する", class: "btn btn-primary btn-lg mt-3" %>
    </div>
  <% end %>
  
  <p class="mt-3 text-danger"><small>※ 投票は一回限りです。</small></p>
