<file path="app/models/vote.rb">
class Vote < ApplicationRecord
  # --- Associations ---
  
  # 投票したユーザー
  belongs_to :user
  # 投票対象のアンケート
  belongs_to :poll
  # 投票した具体的な選択肢 (choice_id というカラム名であると想定)
  belongs_to :choice, foreign_key: :choice_id, optional: true

  # --- Validations ---

  # 1ユーザーは1アンケートに1回のみ投票可能 (複合一意性)
  validates :user_id, uniqueness: { 
    scope: :poll_id, 
    message: "は同じアンケートに二重に投票できません" 
  }

  # 選択肢のIDが必須であることを検証
  # カラム名が chosen_option の場合は :chosen_option に書き換えてください
  validates :choice_id, presence: true

  # カスタムバリデーション: 選択肢がそのアンケートに属しているか確認
  validate :choice_must_belong_to_poll

  private

  def choice_must_belong_to_poll
    return if choice_id.blank? || poll_id.blank?

    # 選択したChoiceのpoll_idと、Voteのpoll_idが一致するかチェック
    unless Choice.exists?(id: choice_id, poll_id: poll_id)
      errors.add(:choice_id, "は指定されたアンケートの有効な選択肢ではありません")
    end
  end
end
</file>

