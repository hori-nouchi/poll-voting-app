<div class="row justify-content-center mt-5">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-lg border-0 rounded-3">
      <div class="card-body p-4 p-md-5">
        
        <%# タイトル %>
        <h1 class="card-title text-center mb-4 fs-3 fw-bold text-primary">ログイン</h1>
        
        <%# フラッシュメッセージ (エラーがある場合、SessionsController#createでflash[:error]が使われることを想定) %>
        <% if flash[:error] %>
          <div class="alert alert-danger fade show rounded-3" role="alert"><%= flash[:error] %></div>
        <% end %>

        <%# フォームの開始: POST /login へ送信 %>
        <%# 環境対応のため data: { turbo: false } を使用し、明示的に POST メソッドを使用 %>
        <%= form_with(url: login_path, method: :post, data: { turbo: false }, local: true) do |form| %>
          
          <%# メールアドレスフィールド %>
          <div class="mb-3">
            <%= form.label :email, "メールアドレス", class: "form-label fw-bold" %>
            <%# name属性を "email" にするため、シンボルではなく文字列で指定します %>
            <%= form.email_field :email, class: "form-control form-control-lg rounded-3", placeholder: "your@example.com", name: "email", required: true %>
          </div>

          <%# パスワードフィールド %>
          <div class="mb-4">
            <%= form.label :password, "パスワード", class: "form-label fw-bold" %>
            <%# name属性を "password" にするため、シンボルではなく文字列で指定します %>
            <%= form.password_field :password, class: "form-control form-control-lg rounded-3", name: "password", required: true %>
          </div>

          <div class="d-grid">
            <%# ログインボタン %>
            <%= form.submit "ログイン", class: "btn btn-primary btn-lg fw-bold rounded-3" %>
          </div>
        <% end %>
        
        <%# 新規登録へのリンク %>
        <div class="text-center mt-4">
          <p class="text-muted mb-0">アカウントをお持ちでないですか？</p>
          <%# signup_path にリダイレクトします (もし /register ならそのパスに修正してください) %>
          <%= link_to "新規登録はこちら", signup_path, class: "text-decoration-none fw-bold text-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>