<div class="row">
    <div class="col-12">

        <%# 🏆 人気ランキング (投票数順) 🏆 %>
        <% if @ranking_polls.any? %>
            <h2 class="h5 mb-3 mt-4">👑 人気ランキング (投票数順)</h2>
            <ul class="list-group mb-4">
                <% @ranking_polls.each_with_index do |poll, index| %>
                    <li class="list-group-item d-flex justify-content-between align-items-center p-3">
                        <div>
                            <%# 順位を表示 %>
                            <span class="badge bg-warning me-2"><%= index + 1 %>位</span>
                            
                            <%# アンケートタイトルを投票ページへのリンクとして表示 %>
                            <%= link_to poll.title, poll_path(poll), class: "text-dark text-decoration-none" %>
                        </div>
                        
                        <%# 投票数を表示 %>
                        <span class="badge bg-secondary rounded-pill">
                            <%= poll.votes.count %> 票
                        </span>
                    </li>
                <% end %>
            </ul>
        <% else %>
            <p class="text-muted">まだ投票されたアンケートがありません。</p>
        <% end %>

        <hr>

        <%# ➕ アンケート新規作成ボタン ➕ %>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h5 mb-0">最新のアンケート一覧</h2>
            <% if current_user %>
                <%= link_to "アンケート新規作成", new_poll_path, class: "btn btn-warning btn-lg fw-bold" %>
            <% end %>
        </div>

        <%# 📝 アンケート一覧表示 %>
        <ul class="list-group list-group-flush mt-3">
            <% if @polls.any? %>
                <% @polls.each do |poll| %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <%= link_to poll.title, poll_path(poll), class: "text-decoration-none text-primary" %>
                        <span class="text-muted"><%= poll.created_at.strftime("%Y/%m/%d") %></span>
                    </li>
                <% end %>
            <% else %>
                <li class="list-group-item text-muted">アンケートはまだ作成されていません。</li>
            <% end %>
        </ul>
        <%# 🚨 【ここを追加】検索バーのフォーム 🚨 %>
        <div class="mt-4 p-3 border border-dark bg-light shadow-sm">
            <%# 検索を実行するフォーム %>
            <%= form_with url: root_path, method: :get, local: true, class: "input-group" do %>
        
                <%= text_field_tag :search, params[:search], 
                    class: "form-control", 
                    placeholder: "タイトルでアンケートを検索" %>
            
                <%= button_tag "検索", type: :submit, class: "btn btn-dark" %>
            <% end %>
        </div>
        
    </div>
</div>