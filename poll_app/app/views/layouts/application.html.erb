<!DOCTYPE html>
<html>
<head>
  <title>アンケート・投票アプリ</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%# PropShaftのエラー回避のためコメントアウト。デプロイ時には必要になる可能性があります。 %>
  <%# <%= javascript_importmap_tags %>
  <%# <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
</head>

<body>
  <header class="p-3 mb-4 border-bottom bg-info-subtle">
    <div class="d-flex flex-wrap align-items-center justify-content-between container">
      <h1 class="fs-4 text-info-emphasis">アンケートアプリ</h1>
      
      <nav class="d-flex align-items-center">
        <a href="<%= root_path %>" class="nav-link d-inline-block px-2 text-dark">Home</a>
        <a href="/help" class="nav-link d-inline-block px-2 text-dark">Help</a>
        
        <div class="ms-3 d-flex align-items-center">
            <% if current_user %>
              <%# ログイン中の表示 %>
              <%= link_to "新規作成", new_poll_path, class: "btn btn-success btn-sm me-2" %>
              
              <%# 🚨 【修正箇所】nameをemailに変更 🚨 %>
              <span class="me-2 text-dark">ようこそ, <%= current_user.email %></span> 
              
              <%# ログアウトボタン %>
              <%= button_to "ログアウト", logout_path, method: :delete, class: "btn btn-outline-dark btn-sm" %>
            <% else %>
              <%# ログアウト中の表示 %>
              <a href="/login" class="btn btn-outline-dark btn-sm me-2">ログイン</a>
              <a href="/register" class="btn btn-primary btn-sm">新規登録</a>
            <% end %>
        </div>
      </nav>
    </div>
  </header>
  
  <main class="container">
    <%= yield %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>