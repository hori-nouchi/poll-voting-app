<!DOCTYPE html>
<html>
  <head>
    <title>アンケートアプリ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%# Importmapの定義は、アセット解決のため残しますが、applicationへの参照は削除済みです。 %>
    <script type="importmap">
      {
        "imports": {
          "@hotwired/turbo-rails": "<%= asset_path("turbo.min.js") %>",
          "@hotwired/stimulus": "<%= asset_path("stimulus.min.js") %>"
        }
      }
    </script>
    
    <%# 🚨 冗長なコアライブラリのインポートを削除しました 🚨 %>
    
  </head>
  <body class="bg-light">
    <!-- ナビゲーションバーや共通ヘッダーの想定 -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
      <div class="container">
        <a class="navbar-brand" href="/">アンケートアプリ</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            
            <%# 🚨 ログイン状態に応じたリンク 🚨 %>
            <li class="nav-item">
              <%= link_to 'アンケート作成', new_poll_path, class: "btn btn-outline-light me-2" %>
            </li>
            <li class="nav-item">
              <%= link_to 'ヘルプ', '#', class: "nav-link" %>
            </li>
            
            <%# ユーザー認証リンク %>
            <%# logged_in? と current_user が定義されていることを前提とします %>
            <% if defined?(logged_in?) && logged_in? %>
              <li class="nav-item">
                <%= link_to "ログアウト", logout_path, data: { turbo_method: :delete }, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <span class="nav-link text-white-50 ms-2">ようこそ, <%= defined?(current_user) && current_user.respond_to?(:email) ? current_user.email : 'ユーザー' %></span>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "ログイン", login_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "新規登録", signup_path, class: "nav-link" %>
              </li>
            <% end %>
            
          </ul>
        </div>
      </div>
    </nav>
    
    <main class="container">
      <% if flash[:notice] || flash[:alert] || flash[:success] || flash[:error] %>
        <div class="alert <%= flash[:notice] || flash[:success] ? 'alert-success' : 'alert-danger' %> alert-dismissible fade show" role="alert">
          <%= flash[:notice] || flash[:alert] || flash[:success] ? 'alert-success' : 'alert-danger' %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    
    <%# 🚨 【コントローラーの登録】すべてのロジックをこの一つのブロックで実行します 🚨 %>
    <script type="module">
      // Turbo RailsとStimulusのコアライブラリをここで一度だけインポートします
      import "@hotwired/turbo-rails";
      import { Application, Controller } from "@hotwired/stimulus";
      
      // Stimulusアプリケーションを起動
      const application = Application.start();

      // NestedFormController の定義
      class NestedFormController extends Controller {
        static targets = ["add_item", "item", "destroy", "container"];

        connect() {
          
        }

        add(event) {
          event.preventDefault();
          const template = this.add_itemTarget.innerHTML.replace(/NEW_RECORD/g, new Date().getTime());
          // 選択肢を1つだけ追加するように修正済み
          this.containerTarget.insertAdjacentHTML('beforeend', template);
        }

        remove(event) {
          event.preventDefault();
          const item = event.target.closest("[data-nested-form-target='item']");
          const destroyField = item.querySelector("[data-nested-form-target='destroy']");
          if (destroyField) {
            destroyField.value = 1;
            item.style.display = 'none';
          } else {
            item.remove();
          }
        }
      }

      // Stimulusインスタンスにコントローラーを登録（一度だけ）
      application.register("nested-form", NestedFormController);

      window.Stimulus = application;
    </script>
    
  </body>
</html>