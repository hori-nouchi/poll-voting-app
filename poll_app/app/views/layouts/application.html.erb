<!DOCTYPE html>
<html>
  <head>
    <title>アンケートアプリ</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%# 🚨 重要: ここに手動の <script type="importmap"> はありません。Railsが自動で生成します。 %>
    
  </head>
  <body class="bg-light">
    <!-- ナビゲーションバーや共通ヘッダーの想定 -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
      <div class="container">
        <%# Navbar BrandをRootに戻します %>
        <%= link_to "アンケートアプリ", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            
            <%# アンケート作成を黄色いボタンにし、ホームとヘルプを通常のnav-itemとして配置します %>
            <li class="nav-item">
              <%= link_to 'ホーム', root_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to 'ヘルプ', help_path, class: "nav-link" %>
            </li>
            <li class="nav-item ms-2">
              <%# アンケート作成ボタンを黄色 (warning) に変更 %>
              <%= link_to 'アンケート作成', new_poll_path, class: "btn btn-warning" %>
            </li>
            
            <%# ユーザー認証リンク %>
            <% if defined?(logged_in?) && logged_in? %>
              <li class="nav-item">
                <span class="nav-link text-white-50 ms-2">ようこそ, <%= defined?(current_user) && current_user.respond_to?(:email) ? current_user.email : 'ユーザー' %></span>
              </li>
              <li class="nav-item">
                <%= link_to "ログアウト", logout_path, data: { turbo_method: :delete }, class: "nav-link" %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "ログイン", login_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%# 修正: signup_path を使用 (config/routes.rb の変更に準拠) %>
                <%= link_to "新規登録", signup_path, class: "nav-link" %>
              </li>
            <% end %>
            
          </ul>
        </div>
      </div>
    </nav>
    
    <main class="container">
      <%# フラッシュメッセージの表示ロジックは維持 %>
      <% if flash[:notice] || flash[:alert] || flash[:success] || flash[:error] %>
        <div class="alert <%= flash[:notice] || flash[:success] ? 'alert-success' : 'alert-danger' %> alert-dismissible fade show" role="alert">
          <%= flash[:notice] || flash[:alert] || flash[:success] || flash[:error] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    
    <%# Importmap環境向けのタグを使用し、外部JSをロードします %>
    <%= javascript_importmap_tags %>
    
  </body>
</html>