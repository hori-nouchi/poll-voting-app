<%# poll: Pollオブジェクト, フォームに渡されることを想定 %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <%# フォーム全体に Stimulus コントローラーを適用し、デザインを統一 %>
    <%= form_with(model: poll, class: "mb-5 p-5 border rounded shadow-lg bg-white", data: { controller: "nested-form" }) do |form| %>

      <%# エラーメッセージ表示 %>
      <% if poll.errors.any? %>
        <div id="error_explanation" class="alert alert-danger rounded-3">
          <h2 class="alert-heading"><%= pluralize(poll.errors.count, "error") %> が原因でこのアンケートは保存できませんでした:</h2>
          <ul>
            <% poll.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# 1. タイトルフィールド %>
      <div class="mb-4">
        <%= form.label :title, "アンケートのタイトル", class: "form-label fs-5 fw-bold" %>
        <%= form.text_field :title, class: "form-control form-control-lg rounded-3", placeholder: "例: 今週のランチは何にする？", required: true %>
      </div>

      <%# 2. 選択肢コンテナ %>
      <h3 class="mt-4 mb-3 fs-5 fw-bold border-bottom pb-2">選択肢</h3>

      <%# 🚨 Stimulusターゲット: 選択肢フィールドを格納するコンテナ (container) 🚨 %>
      <div id="choices-container" data-nested-form-target="container">
        <%# コントローラーでビルドされた既存の/空の選択肢がレンダリングされる %>
        <%= form.fields_for :choices do |choice_fields| %>
          <%= render 'choices/choice_fields', form: choice_fields %>
        <% end %>
      </div>

      <%# 3. 選択肢追加ボタン %>
      <div class="mb-4 text-center">
        <%= link_to '選択肢を追加', '#', 
            data: { 
                action: 'click->nested-form#add',
                # 🚨 修正点: テンプレートを参照するためにターゲット名を "template" に統一 🚨
                nested_form_template_target: "newTemplate" 
            }, 
            class: "btn btn-outline-primary rounded-pill fw-bold" %>
      </div>

      <%# 4. 送信ボタン %>
      <div class="d-grid gap-2 mt-5">
        <%= form.submit poll.persisted? ? "アンケートを更新" : "アンケートを作成", class: "btn btn-primary btn-lg fw-bold rounded-3" %>
      </div>

      <%# 🚨 5. テンプレートの定義 🚨 %>
      <%# 🚨 修正点: Stimulusターゲットを "template" に統一 🚨 %>
      <template data-nested-form-target="template">
        <%= form.fields_for :choices, Choice.new, child_index: "NEW_RECORD" do |choice_fields| %>
          <%= render "choices/choice_fields", form: choice_fields %>
        <% end %>
      </template>
    <% end %>
  </div>
</div>