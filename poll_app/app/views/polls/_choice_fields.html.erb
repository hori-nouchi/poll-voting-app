<%# app/views/polls/_choice_fields.html.erb %>
<%# wrapper ターゲットとして定義し、JavaScriptからこの要素ごと操作できるようにします %>
<div class="nested-fields" data-nested-form-target="wrapper">
  <div class="input-group">
    <%# 選択肢の入力フィールド %>
    <%= form.text_field :content, 
                        class: "form-control", 
                        placeholder: "選択肢を入力してください", 
                        required: true %>

    <%# 削除ボタン: JavaScriptの nested-form#remove アクションを起動 %>
    <button type="button" 
            class="btn btn-outline-danger" 
            data-action="click->nested-form#remove"
            title="削除">
      <i class="bi bi-trash"></i>
    </button>
  </div>

  <%# 🚨 重要: 削除フラグを保持する隠しフィールド 🚨 %>
  <%# allow_destroy: true を設定している場合、このフィールドが '1' になるとレコードが削除されます %>
  <%= form.hidden_field :_destroy %>
</div>