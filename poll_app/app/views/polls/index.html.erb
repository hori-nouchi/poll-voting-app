<h2>全アンケート一覧</h2>
<p class="text-secondary">公開中のアンケートが <%= @polls.count %> 件あります。</p>

<%= form_with(url: polls_path, method: :get, local: true, class: 'mb-4 p-3 border rounded bg-light shadow-sm') do |f| %>
  <div class="input-group">
    <%= f.text_field :search, class: 'form-control', placeholder: 'アンケートタイトルで検索', value: params[:search] %>
    <button class="btn btn-primary" type="submit">検索</button>
  </div>
<% end %>

<div class="list-group">
  <% if @polls.any? %>
    <% @polls.each do |poll| %>
      <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <div>
          <h5 class="mb-1">
            <%= link_to poll.title, poll_path(poll), class: 'text-decoration-none text-dark' %>
          </h5>
          <small class="text-muted">作成者: <%= poll.user.email %> | 作成日時: <%= l poll.created_at, format: :short %></small>
        </div>
        <span class="badge bg-success rounded-pill">
          <%= poll.votes.count %> 票
        </span>
      </div>
    <% end %>
  <% else %>
    <p class="p-3 text-center text-muted">現在、公開中のアンケートはありません。</p>
  <% end %>
</div>