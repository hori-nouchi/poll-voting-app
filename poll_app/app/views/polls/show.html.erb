<h2><%= @poll.title %></h2>
<p class="text-secondary">
    作成者: <%= @poll.user.email %> | 
    作成日時: <%= l @poll.created_at, format: :short %>
</p>

<div class="card p-4 shadow-sm">
    <h4 class="card-title mb-3">投票フォーム</h4>

    <%# 🚨 修正点: data: { turbo: false } を追加し、Turboの非同期処理を無効化しています 🚨 %>
    <%= form_with(url: vote_poll_path(@poll), method: :post, data: { turbo: false }) do %>
        
        <p class="mb-3">いずれか一つの選択肢を選んで投票してください。</p>
        
        <% @poll.choices.each_with_index do |choice, index| %>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="chosen_option" id="option_<%= index %>" value="<%= choice.id %>" required>
                <label class="form-check-label" for="option_<%= index %>">
                    <%= choice.content %>
                </label>
            </div>
        <% end %>

        <hr>
        <button type="submit" class="btn btn-primary btn-lg mt-3">投票する</button>
    <% end %>
    
    <p class="mt-3 text-danger"><small>※ 投票は一回限りです。</small></p>
</div>